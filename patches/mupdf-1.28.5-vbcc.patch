+/* Plain decimals - [-+]digits[.digits], at most 7 significant digits and 10
+   after the point - as one float division.  Both operands are exact in a
+   float (mantissa < 2^24, 10^k with k <= 10), so the IEEE division rounds the
+   exact quotient once: the same float fz_strtof() returns.  An FPU that
+   divides in extended precision first cannot differ either: a quotient over
+   5^10 at most lies more than 2^-50 from any float rounding midpoint, far
+   beyond extended's 2^-64.  Everything else returns 0 and takes the full
+   parser; fz_strtof() on a 68k is 64-bit integer arithmetic throughout, and
+   content streams are mostly numbers like these. */
+static int fast_decimal(const char *s, float *out)
+{
+	static const float pow10f[11] = { 1e0f, 1e1f, 1e2f, 1e3f, 1e4f, 1e5f, 1e6f, 1e7f, 1e8f, 1e9f, 1e10f };
+	unsigned long mant = 0;
+	int neg = 0, frac = -1, digits = 0, any = 0;
+	float v;
+
+	if (*s == '-' || *s == '+')
+		neg = (*s++ == '-');
+	for (;; s++)
+	{
+		if (*s >= '0' && *s <= '9')
+		{
+			any = 1;
+			if (mant != 0 || *s != '0')
+			{
+				if (++digits > 7)
